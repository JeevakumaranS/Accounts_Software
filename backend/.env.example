# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=durozen_accounts
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Authentication
# Replace with a strong, unique secret before running outside local development.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=24h

# Application URLs
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
